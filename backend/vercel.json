{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
