{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate && npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{node_modules/.prisma/**,node_modules/@prisma/client/**,dist/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
